# Dependencies
node_modules/

# Environment / secrets — NEVER commit
.env
.env.local
.env.production
.dev.vars

# Apple Pay certificates — contain private keys, NEVER commit
apple-pay-certs/
*.key
*.pem
*.p12
*.cer
*.csr

# Cloudflare build output
.wrangler/
dist/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Local Netlify folder
.netlify

# Build id written by scripts/bump-cache-version.js on every postinstall.
# It changes on every run, so committing it made every parallel branch conflict
# on it. Cloudflare regenerates it during the build, and header-scroll.js
# no-ops when /version.json is absent, so it never needs to be in git.
version.json
